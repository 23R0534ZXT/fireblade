<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <HostFramework Condition="'$(HostFramework)' == ''">net10.0-windows</HostFramework>
    <TargetFramework>$(HostFramework)</TargetFramework>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>Fireblade.PluginHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup><Compile Remove="qa/**/*.cs;legacy/**/*.cs;qa_legacy/**/*.cs;qa_other/**/*.cs" /></ItemGroup>
</Project>
